        result.`Текущая дата` AS `Текущая дата`,
        result.`Предыдущая дата` AS `Предыдущая дата`,
        result.`Текущее значение` AS `Текущее значение`,
        result.`Предыдущее значение` AS `Предыдущее значение`,
        result.`Единица значения` AS `Единица значения`,
        result.`Изменение метрики` AS `Изменение метрики`,
        result.`Единица изменения` AS `Единица изменения`,
        result.`Изменение структуры` AS `Изменение структуры`,
        result.`GMV WoW %` AS `GMV WoW %`,
        result.`TX WoW %` AS `TX WoW %`,
        result.`AU WoW %` AS `AU WoW %`,
        result.`AM WoW %` AS `AM WoW %`,
        result.`AOV WoW %` AS `AOV WoW %`,
        result.`TPM WoW %` AS `TPM WoW %`,
        result.`Freq WoW %` AS `Freq WoW %`,
        result.robust_z AS robust_z,
        result.materiality_share AS materiality_share,
        result.anomaly_score AS anomaly_score,
        result.`rank` AS `rank`
    FROM $udf_result AS result
);

$technical_row = (
    SELECT
