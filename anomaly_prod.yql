$input = (
    SELECT
        source.period AS period,
        CAST(source.cal_date AS Int64?) AS cal_date,
        source.slice_depth AS slice_depth,
        source.geo AS geo,
        source.products AS products,
        source.merchants_type AS merchants_type,
        source.is_terminal_or_cpqr AS is_terminal_or_cpqr,
        source.gmv AS gmv,
        source.tx0 AS tx0,
        source.tx AS tx,
