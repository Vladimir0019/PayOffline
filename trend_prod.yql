-- WITH TRUNCATE выполняется транзакционно: при исключении UDF предыдущая
-- корректная таблица остаётся без изменений. UDF возвращает только бизнес-
-- строки листа «Менеджерский вывод», без Excel-строки пояснений.
INSERT INTO `//home/fdt/payoffline/projects/qr_yandex_pay/bi/payoffline_pulse_hier_Trend` WITH TRUNCATE
SELECT
        result.segment_name AS `Название сегмента`,
        result.segment_level AS `Уровень сегмента`,
        result.geo AS geo,
        result.products AS products,
        result.merchants_type AS merchants_type,
        result.is_terminal_or_cpqr AS is_terminal_or_cpqr,
        result.current_gmv AS `Текущий GMV`,
        result.trend_direction AS `Динамика`,
        result.local_trend_start_date AS `Начало локального тренда`,
        result.local_trend_end_date AS `Конец локального тренда`,
        result.local_trend_length AS `Длительность локального тренда, периодов`,
        result.local_trend_gmv_change_abs AS `Абсолютное изменение локального тренда, GMV`,
        result.local_trend_gmv_change_relative AS `Относительное изменение локального тренда, пп`,
        result.local_trend_avg_gmv_change_per_period AS `Среднее изменение GMV за период, локальный тренд`,
        result.global_trend_start_date AS `Начало глобального тренда`,
        result.global_trend_end_date AS `Конец глобального тренда`,
        result.global_trend_length AS `Длительность глобального тренда, периодов`,
        result.global_trend_gmv_change_abs AS `Абсолютное изменение глобального тренда, GMV`,
        result.global_trend_gmv_change_relative AS `Относительное изменение глобального тренда, пп`,
        result.global_trend_avg_gmv_change_per_period AS `Среднее изменение GMV за период, глобальный тренд`,
        result.global_trend_start_total_gmv_share AS `Доля в Total GMV в начале глобального тренда, пп`,
        result.global_trend_end_total_gmv_share AS `Доля в Total GMV в конце глобального тренда, пп`,
        result.global_trend_total_gmv_share_change_pp AS `Изменение доли в Total GMV, пп`,
        result.global_trend_total_gmv_share_dynamics AS `Динамика доли в Total GMV`,
        result.global_trend_reversal_detected AS `Разворот перед глобальным трендом`,
        result.pre_global_trend_direction AS `Направление до глобального тренда`,
        result.structural_change_detected AS `Есть структурная точка`,
        result.last_structural_change_type AS `Тип последнего структурного изменения`,
        result.last_structural_level_shift AS `Изменение уровня в последней структурной точке, GMV`,
        result.global_trend_structure AS `Структура глобального тренда`,
        result.last_local_trend_contribution_to_global_change_pct AS `Вклад последнего локального тренда в изменение глобального тренда, пп`,
        result.local_trend_contributions_to_global_change AS `Вклады локальных трендов в изменение глобального тренда`,
        result.trend_selected AS `Отобран оптимизацией`
FROM (
    REDUCE $input
    ON period
    USING ALL $run_algorithm(TableRows())
) AS result;
